import java.util.Scanner;

public class ej_6 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        double precioBase = 0;
        int opcionSabor;

        // Validar selección de sabor
        do {
            System.out.println("Seleccione el sabor (1: Manzana | 2: Fresa | 3: Chocolate): ");
            opcionSabor = scanner.nextInt();

            switch (opcionSabor) {
                case 1: // Manzana
                    precioBase = 200;
                    break;

                case 2: // Fresa
                    precioBase = 250;
                    break;

                case 3: // Chocolate (Switch anidado con validacion)
                    int tipoChocolate;
                    do {
                        System.out.println("Seleccione tipo de chocolate (1: Negro $280 | 2: Blanco $300): ");
                        tipoChocolate = scanner.nextInt();

                        switch (tipoChocolate) {
                            case 1:
                                precioBase = 280;
                                break;
                            case 2:
                                precioBase = 300;
                                break;
                            default:
                                System.out.println("Tipo de chocolate no valido. Intente de nuevo.\n");
                                break;
                        }
                    } while (tipoChocolate < 1 || tipoChocolate > 2);
                    break;

                default:
                    System.out.println("Sabor no valido. Intente de nuevo.\n");
                    break;
            }
        } while (opcionSabor < 1 || opcionSabor > 3);

        // Snacks ($25 por cada uno)
        int cantidadSnacks;
        do {
            System.out.print("¿Cuántos snacks desea agregar?: ");
            cantidadSnacks = scanner.nextInt();
            if (cantidadSnacks < 0) {
                System.out.println("La cantidad no puede ser negativa.\n");
            }
        } while (cantidadSnacks < 0);

        double costoSnacks = cantidadSnacks * 25;

        // Nombre personalizado ($30 extra)
        int opcionNombre;
        double costoNombre = 0;
        do {
            System.out.print("¿Desea personalizar con un nombre? (1: Sí / 2: No): ");
            opcionNombre = scanner.nextInt();

            switch (opcionNombre) {
                case 1:
                    costoNombre = 30;
                    break;
                case 2:
                    costoNombre = 0;
                    break;
                default:
                    System.out.println("Opcion no valida. Intente de nuevo.\n");
                    break;
            }
        } while (opcionNombre < 1 || opcionNombre > 2);

        double total = precioBase + costoSnacks + costoNombre;

        System.out.println("\n--- Presupuesto ---");
        System.out.println("Precio base: $" + precioBase);
        System.out.println("Snacks: +$" + costoSnacks);
        System.out.println("Nombre: +$" + costoNombre);
        System.out.println("Total a pagar: $" + total + " pesos");

        scanner.close();
    }
}